<Project Sdk="Microsoft.NET.Sdk">

  <!-- The X-Ray family's umbrella package. It carries no code of its own: installing it pulls
       in every X-Ray package, so a consumer who wants the whole family writes one line instead
       of tracking the list. Each member also stays installable on its own. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XRay</RootNamespace>
    <AssemblyName>XRay</AssemblyName>

    <!-- NuGet package metadata -->
    <PackageId>X-Ray</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Curiosity GmbH</Authors>
    <Description>The umbrella package for the X-Ray family of .NET libraries. Carries no code of its own — installing it brings in every X-Ray package, currently X-Ray.Content for content extraction from PDF, Office, email, archives and 90+ more formats. Install a single member directly if you only need one.</Description>
    <!-- Not plain MIT: X-Ray.Content derives some files from Apache-2.0-only Rust crates, and a
         metapackage's expression has to cover what it installs. See dotnet/THIRD_PARTY_NOTICES.md. -->
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>x-ray;metapackage;document;extraction;content</PackageTags>
    <RepositoryUrl>https://github.com/curiosity-ai/x-ray-content</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/curiosity-ai/x-ray-content/tree/main/dotnet</PackageProjectUrl>
    <IsPackable>true</IsPackable>

    <!-- A metapackage ships dependencies, not assemblies. `IncludeBuildOutput=false` drops the
         (empty) XRay.dll, and NU5128 is the warning NuGet raises for a package that declares a
         dependency group without a matching lib/ folder — which is exactly what this is. The
         dependencies themselves must NOT be suppressed; they are the entire payload. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- The family's icon, shared with the member packages rather than duplicated. Packed
         because PackageIcon names it; the README links the logo by absolute URL, since
         nuget.org renders neither relative image paths nor raw HTML. -->
    <None Include="../XRay.Content/logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every family member goes here. A ProjectReference to a packable project becomes a
         PackageReference in the produced nuspec, at the version the referenced project was
         packed with — so publishing the family from one pipeline run keeps this package's
         dependencies pinned to that run automatically, with nothing to bump by hand. -->
    <ProjectReference Include="../XRay.Content/XRay.Content.csproj" />
  </ItemGroup>

</Project>
